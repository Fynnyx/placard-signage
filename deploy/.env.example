# Public host name of the dashboard; Caddy gets a Let's Encrypt certificate for it.
DOMAIN=signage.example.org
# E-mail for Let's Encrypt notices.
ACME_EMAIL=admin@example.org
# Time zone of the container (the schedule time zone is set in the dashboard).
TZ=Europe/Berlin
# Optional: share this with content sites that verify signed URLs.
# URL_SIGNING_SECRET=
